# Only source, Python locks, the entrypoint and the container CLI integrity lock
# enter the build context; local state and secrets stay excluded.
**
!pyproject.toml
!uv.lock
!src/
!docker/entrypoint.sh
!docker/cli/package.json
!docker/cli/package-lock.json
!docker/cli/.npmrc
**/__pycache__
**/*.py[cod]
